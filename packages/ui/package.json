    "react-dom": "^18.3.0 || ^19.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@types/node": "^24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/parser": "^8.70.1",
    "clsx": "^2.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.48.0",
