#!/bin/sh
# 偽の niho-speech（specs/initiatives/niho-docs.md §6.2 の契約どおりの固定の出力）。
# 本物（S1-C #18403 の Swift sidecar）が入るまで、開発ビルドの NIHO docs がこれで文字起こしを通す。
# 音声は読まない。convert は 95 秒の音声として振る舞い、transcribe は --start / --end の範囲の固定の区切りを返す。
# slice は区切りの WAV の代わりに範囲を書いたファイルを置く（Gemini＝Antigravity CLI の文字起こし用）。
# record は 0.2 秒ごとに音量の行を出し、SIGTERM で合成音のテスト素材（13.35 秒）を --output に写す。
# マイクの状態は印のファイルで変える: sidecar/fake/.mic-denied（許可が無い）・sidecar/fake/.mic-none（入力の装置が無い）。
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
cmd="${1:-}"
[ $# -gt 0 ] && shift
input=""
output=""
start="0"
end="999999"
speaker_map=""
while [ $# -gt 0 ]; do
  case "$1" in
    --input) input="$2"; shift 2 ;;
    --output) output="$2"; shift 2 ;;
    --start) start="$2"; shift 2 ;;
    --end) end="$2"; shift 2 ;;
    --speaker-map) speaker_map="$2"; shift 2 ;;
    *) shift ;;
  esac
done

case "$cmd" in
  probe)
    printf '%s\n' '{"available":true,"needsDownload":false,"engine":"fake","diarization":{"state":"ready","detail":null}}'
    ;;
  download)
    printf '%s\n' '{"type":"progress","ratio":1.0,"phase":"diarization"}'
    printf '%s\n' '{"type":"done","ok":true}'
    ;;
  convert)
    if [ -z "$input" ] || [ ! -f "$input" ]; then
      echo "input not found" >&2
      exit 3
    fi
    : > "$output"
    printf '%s\n' '{"durationSec":95.0}'
    ;;
  silence)
    printf '%s\n' '{"cuts":[48.0],"soundSec":[48.0,47.0]}'
    ;;
  slice)
    # 区切りの WAV の代わりに、受け取った範囲を書く（Gemini の文字起こしの偽物の確認用）
    printf 'slice %s %s\n' "$start" "$end" > "$output"
    awk -v s="$start" -v e="$end" 'BEGIN { printf "{\"durationSec\":%.2f}\n", e - s }'
    ;;
  diarize)
    if [ -z "$input" ] || [ ! -f "$input" ] || [ -z "$output" ]; then
      printf '%s\n' '{"type":"error","code":"input_not_found","message":"input not found"}'
      exit 3
    fi
    printf '%s\n' '{"version":1,"duration":95,"turns":[{"start":0,"end":47.9,"id":1},{"start":48,"end":95,"id":2}]}' > "$output"
    printf '%s\n' '{"ok":true,"turns":2}'
    ;;
  transcribe)
    awk -v s="$start" -v e="$end" -v map="$speaker_map" 'BEGIN {
      n = 0
      seg[++n] = "2.0|6.5|今日は集まっていただきありがとうございます。最初に、前回の振り返りから始めます。"
      seg[++n] = "8.0|14.2|前回決めたことは二つで、受付の流れを見直すことと、月末の集まりの日程を決めることでした。"
      seg[++n] = "16.0|22.8|受付は紙の名簿をやめて、QR で受け付ける形に変えてみました。"
      seg[++n] = "25.1|31.0|やってみると、初めての人でも迷わずに済んだという声が多かったです。"
      seg[++n] = "49.0|55.5|次に日程です。月末の土曜日でどうかという案が出ています。"
      seg[++n] = "57.2|63.9|土曜だと来られない人もいるので、日曜と両方で聞いてみるのがいいと思います。"
      seg[++n] = "66.0|72.4|では、両方の候補で出欠を取ることにします。締め切りは来週の金曜日です。"
      seg[++n] = "75.0|81.3|最後に、次回までの宿題を確認します。出欠の案内は私が出します。"
      count = 0
      for (i = 1; i <= n; i++) {
        split(seg[i], f, "|")
        if (f[1] + 0 >= s + 0 && f[1] + 0 < e + 0) {
          if (map != "") {
            speaker = (f[1] + 0 < 48) ? 1 : 2
            printf "{\"type\":\"segment\",\"start\":%s,\"end\":%s,\"text\":\"%s\",\"speaker\":%d}\n", f[1], f[2], f[3], speaker
          } else {
            printf "{\"type\":\"segment\",\"start\":%s,\"end\":%s,\"text\":\"%s\"}\n", f[1], f[2], f[3]
          }
          count++
          printf "{\"type\":\"progress\",\"ratio\":%.2f}\n", i / n
        }
      }
      printf "{\"type\":\"done\",\"segments\":%d,\"durationMs\":1200,\"diarization\":false}\n", count
    }'
    ;;
  mic-status)
    if [ -f "$here/.mic-denied" ]; then
      printf '%s\n' '{"status":"denied"}'
    else
      printf '%s\n' '{"status":"authorized"}'
    fi
    ;;
  record)
    if [ -f "$here/.mic-none" ]; then
      printf '%s\n' '{"type":"error","code":"no_input_device","message":"no input device (connect a microphone)"}'
      exit 2
    fi
    if [ -f "$here/.mic-denied" ]; then
      printf '%s\n' '{"type":"error","code":"microphone_permission_denied","message":"microphone access is denied"}'
      exit 4
    fi
    caf="${output%.*}.recording.caf"
    : > "$caf"
    stopped=0
    trap 'stopped=1' TERM INT
    printf '%s\n' '{"type":"started","device":"偽のマイク","sampleRate":24000}'
    n=0
    while [ "$stopped" = 0 ]; do
      n=$((n + 1))
      awk -v n="$n" 'BEGIN { printf "{\"type\":\"level\",\"db\":%.1f,\"durationSec\":%.2f}\n", -24 - (n % 7) * 4, n * 0.2 }'
      sleep 0.2 || true
    done
    cp "$here/../../fixtures/audio/synthetic-tone.m4a" "$output"
    rm -f "$caf"
    printf '{"type":"done","file":"%s","durationSec":13.35,"bytes":%d}\n' "$output" "$(wc -c < "$output" | tr -d ' ')"
    ;;
  *)
    echo "unknown command: $cmd" >&2
    exit 3
    ;;
esac
